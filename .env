# --- VERSIONS DES IMAGES ---
JUPYTER_IMAGE=jupyter/pyspark-notebook:latest
CONFLUENT_VERSION=7.4.0
SPARK_VERSION=3.5.0
HADOOP_VERSION=2.0.0-hadoop3.2.1-java8

# --- CONFIGURATION JUPYTER ---
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
JUPYTER_TOKEN=admin

# --- CONFIGURATION ZOOKEEPER ---
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# --- CONFIGURATION KAFKA ---
KAFKA_PORT=9092
KAFKA_BROKER_ID=1
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# --- CONFIGURATION SPARK ---
SPARK_MASTER_WEBUI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_MEMORY=1G
SPARK_RPC_AUTH=no
SPARK_SSL=no

# --- CONFIGURATION HADOOP ---
HADOOP_NAMENODE_WEBUI_PORT=9870
HADOOP_NAMENODE_PORT=9000
HADOOP_CLUSTER_NAME=test

# --- CONFIGURATION AIRFLOW & POSTGRES ---
POSTGRES_IMAGE=postgres:13
AIRFLOW_IMAGE=apache/airflow:2.8.0

# Identifiants Base de données
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Configuration Airflow
AIRFLOW_WEBSERVER_HOST_PORT=8081
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Réseau partagé 
SHARED_NETWORK_NAME=docker_compose_big_data_network